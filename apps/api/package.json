{
  "name": "@tipme/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "nest build",
    "dev": "nest start --watch --exec \"node --env-file-if-exists=../../.env --import ./dist/instrument.js\"",
    "start": "node --env-file-if-exists=../../.env --import ./dist/instrument.js dist/main.js",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "test": "node --import @tipme/observability/register --test test/*.test.mjs"
  },
  "dependencies": {
    "@nestjs/common": "12.1.3",
    "@nestjs/core": "12.1.3",
    "@nestjs/platform-express": "12.1.3",
    "@opentelemetry/api": "1.9.1",
    "@tipme/contracts": "workspace:*",
    "@tipme/database": "workspace:*",
    "@tipme/domain": "workspace:*",
    "@tipme/observability": "workspace:*",
    "@tipme/payments": "workspace:*",
    "bullmq": "6.3.11",
    "ioredis": "5.11.1",
    "pg": "8.23.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "sharp": "0.35.5",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@nestjs/cli": "12.0.8",
    "@tipme/config": "workspace:*",
    "@types/express": "5.0.6",
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "typescript": "5.9.3"
  }
}
