{
  "$schema": "https://turborepo.com/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"],
      "env": [
        "NEXT_PUBLIC_API_ORIGIN",
        "NEXT_PUBLIC_PRETEND_DELIVERY",
        "PRODUCTION_LAUNCH_AT",
        "SITE_URL",
        "API_INTERNAL_ORIGIN",
        "NEXT_PUBLIC_PREVIEW_GATE",
        "NEXT_PUBLIC_SENTRY_DSN",
        "NEXT_PUBLIC_SENTRY_ENVIRONMENT",
        "SENTRY_AUTH_TOKEN"
      ]
    },
    "lint": {
      "dependsOn": ["^build"]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["build"],
      "outputs": []
    },
    "dev": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true,
      "passThroughEnv": ["HOST", "PORT", "NEXT_TELEMETRY_DISABLED"]
    }
  }
}
