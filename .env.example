# Local development only. NEVER put real secrets in git.
# Copy to .env; the API and worker load it with Node's --env-file-if-exists.
NODE_ENV=development
WEB_ORIGIN=http://localhost:3000
# Where the browser reaches the API (inlined into the web build).
NEXT_PUBLIC_API_ORIGIN=http://localhost:4000
# Web error reporting (docs/runbooks/sentry.md). Empty locally: nothing is sent.
NEXT_PUBLIC_SENTRY_DSN=
API_ORIGIN=http://localhost:4000
HOST=127.0.0.1
PORT=4000
DATABASE_URL=postgresql://tipme_local:tipme_local_password@localhost:5432/tipme_local?schema=public
REDIS_URL=redis://localhost:6379
PAYMENT_PROVIDER=mock
PAYMENTS_LIVE_ENABLED=false
# Optional local/test sandbox checkout only; use Bachs sandbox-issued values, never live credentials.
# Select PAYMENT_PROVIDER=bachs-sandbox only with NODE_ENV=test/development or protected preview.
# BACHS_SANDBOX_API_KEY=sk_sandbox_...
# BACHS_WEBHOOK_SECRET=
# BACHS_PREVIOUS_WEBHOOK_SECRET=
# Traces go to the local Jaeger from docker compose; leave empty to disable export.
OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4318
OTEL_TRACES_SAMPLER_RATIO=1
# Prometheus-format metrics, loopback only: curl http://127.0.0.1:9464/metrics
API_METRICS_PORT=9464
WORKER_METRICS_PORT=9465
LOG_LEVEL=info
# Enables the trace probe used by `pnpm trace:demo`. Refused when NODE_ENV=production.
DIAGNOSTICS_ENABLED=true
QUEUE_PREFIX=tipme
# Mock provider webhook signing secret (local only, >= 32 chars). Never a real secret.
MOCK_PROVIDER_WEBHOOK_SECRET=local-only-mock-webhook-secret-change-me-32
# Derives private receipt links (status tokens). At least 32 characters.
STATUS_TOKEN_SECRET=local-only-status-token-secret-change-me-32
# Proxies in front of the API whose X-Forwarded-For is trusted (0 locally).
TRUST_PROXY_HOPS=0
# Keys recipients' sign-in codes (HMAC). At least 32 characters.
AUTH_CODE_SECRET=local-only-auth-code-secret-change-me-32-chars
# Pretend WhatsApp/SMS/email delivery (development only; refused in production).
# Mail: mock writes to the pretend inbox (development); zeptomail or ses send for real.
MAIL_DEFAULT_PROVIDER=mock
MAIL_FROM_ADDRESS=hello@mail.usetipme.xyz
MAIL_FROM_NAME=TipMe
MAIL_REPLY_TO=
# ZeptoMail (all three to configure it): Send Mail token, the account's API base for its data
# centre (e.g. https://api.zeptomail.com), and the Agent's webhook authentication key.
ZEPTOMAIL_API_KEY=
ZEPTOMAIL_API_BASE=
ZEPTOMAIL_WEBHOOK_KEY=
ZEPTOMAIL_BOUNCE_ADDRESS=
# Amazon SES in the project region (the three names to configure it). Access keys: both or
# neither (neither uses the machine's role). Created 30 Oct 2026: tipme-<env>-tracked,
# tipme-<env>-untracked, arn:aws:sns:eu-north-1:<account>:tipme-<env>-mail-events.
SES_REGION=eu-north-1
SES_ACCESS_KEY_ID=
SES_SECRET_ACCESS_KEY=
SES_CONFIGURATION_SET=
SES_CONFIGURATION_SET_UNTRACKED=
SES_SNS_TOPIC_ARN=
# Shared by the API and the web app so profile changes refresh cached pages. At least 32 characters.
WEB_REVALIDATE_SECRET=local-only-revalidate-secret-change-me-32
# Seals staff authenticator secrets (AES-256-GCM). 32 random bytes, base64:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
OPS_TOTP_KEY=
# Seals queued email (addresses, codes, links) at rest, for the API and worker. 32 random bytes, base64.
MAIL_SEAL_KEY=
# Anonymous analytics (API and worker). Unset: on in development and test, off in production
# until the privacy decision D-07. Per-client limit on /v1/events per minute.
ANALYTICS_ENABLED=
RATE_LIMIT_ANALYTICS_PER_MIN=120
# Link from an admin issue to its trace ({traceId} is replaced). Unset: local Jaeger outside production.
OPS_TRACE_URL_TEMPLATE=
# Worker: monthly budget for TipMe's pretend cash rewards, in minor units (₦250,000).
REWARD_CASH_BUDGET_MINOR_PER_MONTH=25000000
