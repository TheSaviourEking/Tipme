# TipMe staging settings (PR-010). Names only: copy to /srv/tipme/staging.env on the server
# (chmod 600, owned by the deploy user) and fill in. Never commit the filled-in file.
# Generate secrets with:
#   POSTGRES_PASSWORD:          openssl rand -hex 32      (it goes inside a URL: hex only)
#   OPS_TOTP_KEY, BACKUP_KEY:   openssl rand -base64 32   (exactly 32 bytes)
#   every other secret:         openssl rand -base64 48

# --- Hosts (your domain) ---
API_HOST=api.staging.example.com
ACME_EMAIL=you@example.com
WEB_ORIGIN=https://staging.example.com
WEB_REVALIDATE_URL=https://staging.example.com/api/revalidate
PREVIEW_COOKIE_DOMAIN=staging.example.com

# --- What this copy is ---
NODE_ENV=production
DEPLOYMENT_MODE=preview
RELEASE_KIND=test
HOST=0.0.0.0
PORT=4000
# Caddy is the one proxy in front of the API.
TRUST_PROXY_HOPS=1

# --- Pretend money and messages only (D-03..D-08 open) ---
PAYMENT_PROVIDER=mock
PAYMENTS_LIVE_ENABLED=false
MESSAGING_PROVIDER=mock
ANALYTICS_ENABLED=true

# --- Secrets (fill in; same PREVIEW_PASSWORD and WEB_REVALIDATE_SECRET on Vercel) ---
POSTGRES_PASSWORD=
PREVIEW_PASSWORD=
MOCK_PROVIDER_WEBHOOK_SECRET=
STATUS_TOKEN_SECRET=
AUTH_CODE_SECRET=
WEB_REVALIDATE_SECRET=
OPS_TOTP_KEY=
RELEASE_CHECK_TOKEN=
# 32 random bytes, base64. Keep a copy OFF the server: without it backups cannot be read.
BACKUP_KEY=

# --- Backups ---
BACKUP_RETAIN=14
# Optional off-server copy with rclone (any S3-compatible bucket), e.g. remote:tipme-staging-backups
BACKUP_RCLONE_REMOTE=
