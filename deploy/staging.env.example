# TipMe staging settings (PR-010). Names only: copy to /srv/tipme/staging.env on the server
# (chmod 600, owned by the deploy user) and fill in. Never commit the filled-in file.
# Generate secrets with:
#   POSTGRES_*_PASSWORD:        openssl rand -hex 32      (they go inside URLs: hex only)
#   OPS_TOTP_KEY, MAIL_SEAL_KEY, BACKUP_KEY:   openssl rand -base64 32   (exactly 32 bytes)
#   other TipMe-managed secrets: openssl rand -base64 48
# Bachs sandbox credentials are obtained from Bachs; do not generate or use live credentials.

# --- Hosts (your domain) ---
API_HOST=api.staging.example.com
ACME_EMAIL=you@example.com
WEB_ORIGIN=https://staging.example.com
WEB_REVALIDATE_URL=https://staging.example.com/api/revalidate
PREVIEW_COOKIE_DOMAIN=staging.example.com

# --- What this copy is ---
NODE_ENV=production
DEPLOYMENT_MODE=preview
RELEASE_KIND=test
HOST=0.0.0.0
PORT=4000
# Caddy is the one proxy in front of the API.
TRUST_PROXY_HOPS=1

# --- Test-only payments and messages (D-03..D-08 and D-11 open) ---
# Keep mock unless intentionally testing Bachs from this password-protected preview.
PAYMENT_PROVIDER=mock
PAYMENTS_LIVE_ENABLED=false
MESSAGING_PROVIDER=mock
ANALYTICS_ENABLED=true

# --- Secrets (fill in; same PREVIEW_PASSWORD and WEB_REVALIDATE_SECRET on Vercel) ---
POSTGRES_PASSWORD=
POSTGRES_RUNTIME_PASSWORD=
POSTGRES_MIGRATOR_PASSWORD=
POSTGRES_BACKUP_PASSWORD=
PREVIEW_PASSWORD=
MOCK_PROVIDER_WEBHOOK_SECRET=
# Required only when PAYMENT_PROVIDER=bachs-sandbox. Use Bachs sandbox credentials only.
BACHS_SANDBOX_API_KEY=
BACHS_WEBHOOK_SECRET=
# Optional old Bachs signing secret during webhook-secret rotation.
BACHS_PREVIOUS_WEBHOOK_SECRET=
STATUS_TOKEN_SECRET=
AUTH_CODE_SECRET=
WEB_REVALIDATE_SECRET=
OPS_TOTP_KEY=
MAIL_SEAL_KEY=
RELEASE_CHECK_TOKEN=
# 32 random bytes, base64. Keep a copy OFF the server: without it backups cannot be read.
BACKUP_KEY=

# --- Error tracking (PR-011; optional, off when empty) ---
# A Sentry or GlitchTip project DSN. Only the error type, a safe code, stack frames, route or job
# and trace id are sent: never messages, request bodies, cookies, headers or user data.
SENTRY_DSN=
SENTRY_ENVIRONMENT=staging

# --- Backups ---
BACKUP_RETAIN=14
# Optional off-server copy: put BACKUP_RCLONE_REMOTE and RCLONE_CONFIG_<NAME>_* in the separate
# /srv/tipme/offsite.env file; never put bucket credentials in this file.
