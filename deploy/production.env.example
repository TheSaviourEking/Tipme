# TipMe production settings. Names only: copy to /srv/tipme-production/production.env on the server
# (chmod 600, owned by the deploy user) and fill in. Never commit the filled-in file.
# Generate secrets with:
#   POSTGRES_*_PASSWORD:        openssl rand -hex 32      (letters and digits only; Aiven roles)
#   OPS_TOTP_KEY, MAIL_SEAL_KEY:   openssl rand -base64 32   (exactly 32 bytes)
#   other TipMe-managed secrets: openssl rand -base64 48
# Third-party credentials (Bachs, ZeptoMail, R2, Sentry) come from those services. Keep a copy of
# every secret OFF the server.
# SITE_INDEXING is a Vercel setting (the web app), not read here.
# PILOT_NOTICE is a Vercel setting too (the web app): docs/runbooks/production.md, section 9.

# --- Where things live ---
# Holds db-ca.pem (Aiven's CA certificate) and this file.
TIPME_HOME=/srv/tipme-production
API_HOST=api.usetipme.xyz
# Where the deploy checks /health/ready and /health/release; blank means https://$API_HOST.
# Only the local rehearsal sets it (plain http).
HEALTH_BASE_URL=
WEB_ORIGIN=
WEB_REVALIDATE_URL=

# --- Versions (set by the deploy script, not by hand) ---
TIPME_VERSION=
TIPME_BLUE_VERSION=
TIPME_GREEN_VERSION=

# --- Database (Aiven; postgres://<role>:<password>@<host>:<port>/tipme?sslmode=verify-full&sslrootcert=/run/secrets/db-ca.pem) ---
# Runtime role, for the API and worker.
DATABASE_URL=
# Migrator role, for migrations only.
MIGRATION_DATABASE_URL=
# Aiven's admin, for the db-roles tool only. Never given to the API or worker.
DATABASE_ADMIN_URL=
# Pools size themselves from the server's max_connections, at startup and every minute: a plan
# change needs nothing here (docs/runbooks/remote-database.md). Leave these blank. A number overrides
# the computed size of an API copy or a worker, for an emergency.
DATABASE_POOL_MAX=
WORKER_DATABASE_POOL_MAX=
# Slots to leave beyond the reserved ones: the provider's own sessions, and one-off tasks (blank = 7).
DATABASE_BUDGET_MARGIN=
# Longest wait for a connection before a clean 503 (blank = 5000).
DATABASE_POOL_CONNECT_TIMEOUT_MS=
POSTGRES_RUNTIME_PASSWORD=
POSTGRES_MIGRATOR_PASSWORD=
POSTGRES_BACKUP_PASSWORD=
MIGRATE_CONFIRM_DATABASE=
MIGRATE_BACKUP_DONE=

# --- Payments (live payments stay off until the processor is approved) ---
# bachs-live is the payments plan's live provider; production refuses mock and sandbox. No default.
# PAYMENTS_LIVE_ENABLED=false starts the site with payments switched off. The config refuses
# bachs-live without the live key and webhook secret below.
PAYMENT_PROVIDER=bachs-live
PAYMENTS_LIVE_ENABLED=false
# Who may take real tips while PAYMENTS_LIVE_ENABLED=true: handles separated by commas, or * for
# everyone. Blank is nobody. Start with the owner's handle (docs/runbooks/live-activation.md).
LIVE_CHECKOUT_HANDLES=
# The live key starts with sk_live_ and comes from the Bachs live dashboard.
BACHS_LIVE_API_KEY=
BACHS_LIVE_WEBHOOK_SECRET=
# Optional old Bachs live signing secret during webhook-secret rotation.
BACHS_LIVE_PREVIOUS_WEBHOOK_SECRET=
RECONCILE_INTERVAL_MS=
RECONCILE_MIN_AGE_MS=
# The payment reserve counts as low below this many kobo (blank = 100000, which is ₦1,000).
BACHS_RESERVE_ALERT_MINOR=
# Where the worker posts reserve alerts: a Slack incoming webhook. A secret (the address is the
# credential). Blank with PAYMENTS_LIVE_ENABLED=false: the alert is only written to the worker log.
# Blank with PAYMENTS_LIVE_ENABLED=true: the deploy stops before it changes anything.
ALERT_WEBHOOK_URL=
# Cash reward budget (minor units). Keep 0 (or unset) until D-05 decides cash rewards:
# the worker refuses any other value on production.
REWARD_CASH_BUDGET_MINOR_PER_MONTH=0

# --- Mail (no default: the deploy refuses until this is chosen) ---
# zeptomail or ses (mock sends nothing). Production mail is ZeptoMail from usetipme.xyz.
MAIL_DEFAULT_PROVIDER=zeptomail
MAIL_FROM_DOMAIN=usetipme.xyz
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME=TipMe
MAIL_REPLY_TO=support@usetipme.xyz
ZEPTOMAIL_API_KEY=
ZEPTOMAIL_API_BASE=
ZEPTOMAIL_WEBHOOK_KEY=
ZEPTOMAIL_BOUNCE_ADDRESS=
# Amazon SES (production access is not granted yet: the account is in the sandbox).
SES_REGION=
SES_ACCESS_KEY_ID=
SES_SECRET_ACCESS_KEY=
SES_CONFIGURATION_SET=
SES_CONFIGURATION_SET_UNTRACKED=
SES_SNS_TOPIC_ARN=

# --- Secrets (fill in; WEB_REVALIDATE_SECRET is the same on Vercel) ---
STATUS_TOKEN_SECRET=
AUTH_CODE_SECRET=
WEB_REVALIDATE_SECRET=
OPS_TOTP_KEY=
MAIL_SEAL_KEY=

# --- Page photos in a private Cloudflare R2 bucket (all four, or none) ---
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# --- Observability and limits (optional; blank takes the default) ---
SENTRY_DSN=
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_TRACES_SAMPLER_RATIO=
OPS_TRACE_URL_TEMPLATE=
API_METRICS_PORT=
WORKER_METRICS_PORT=
LOG_LEVEL=
DIAGNOSTICS_ENABLED=
# Live updates (true/false). Turn on only after staging has run a week with it (runbook).
LIVE_UPDATES_ENABLED=
LIVE_MAX_STREAMS=
ANALYTICS_ENABLED=
PORT=
QUEUE_PREFIX=
RATE_LIMIT_QUOTES_PER_MIN=
RATE_LIMIT_INTENTS_PER_MIN=
RATE_LIMIT_HANDLES_PER_MIN=
RATE_LIMIT_ANALYTICS_PER_MIN=
RATE_LIMIT_REPORTS_PER_HOUR=
RATE_LIMIT_UNSUBSCRIBE_PER_MIN=
RATE_LIMIT_AVATARS_PER_HOUR=
RATE_LIMIT_OPS_CODE_PER_HOUR=
RATE_LIMIT_OPS_REQUEST_PER_HOUR=
RATE_LIMIT_COVER_DESIGNS_PER_HOUR=
RATE_LIMIT_QR_ART_PER_HOUR=
RATE_LIMIT_QR_THUMBS_PER_HOUR=
RATE_LIMIT_BANK_RESOLVE_PER_HOUR=
RATE_LIMIT_BANK_READ_PER_MIN=
RATE_LIMIT_LIVE_CONNECT_PER_MIN=
RATE_LIMIT_AUTH_PER_HOUR=
RATE_LIMIT_CODES_PER_NUMBER_PER_HOUR=
