# TipMe production settings. Names only: copy to /srv/tipme-production/production.env on the server
# (chmod 600, owned by the deploy user) and fill in. Never commit the filled-in file.
# Generate secrets with:
#   POSTGRES_*_PASSWORD:        openssl rand -hex 32      (letters and digits only; Aiven roles)
#   OPS_TOTP_KEY, MAIL_SEAL_KEY:   openssl rand -base64 32   (exactly 32 bytes)
#   other TipMe-managed secrets: openssl rand -base64 48
# Third-party credentials (Bachs, ZeptoMail, R2, Sentry) come from those services. Keep a copy of
# every secret OFF the server.
# SITE_INDEXING is a Vercel setting (the web app), not read here.

# --- Where things live ---
# Holds db-ca.pem (Aiven's CA certificate) and this file.
TIPME_HOME=/srv/tipme-production
API_HOST=api.usetipme.xyz
# Where the deploy checks /health/ready and /health/release; blank means https://$API_HOST.
# Only the local rehearsal sets it (plain http).
HEALTH_BASE_URL=
WEB_ORIGIN=
WEB_REVALIDATE_URL=

# --- Versions (set by the deploy script, not by hand) ---
TIPME_VERSION=
TIPME_BLUE_VERSION=
TIPME_GREEN_VERSION=

# --- Database (Aiven; postgres://<role>:<password>@<host>:<port>/tipme?sslmode=verify-full&sslrootcert=/run/secrets/db-ca.pem) ---
# Runtime role, for the API and worker.
DATABASE_URL=
# Migrator role, for migrations only.
MIGRATION_DATABASE_URL=
# Aiven's admin, for the db-roles tool only. Never given to the API or worker.
DATABASE_ADMIN_URL=
POSTGRES_RUNTIME_PASSWORD=
POSTGRES_MIGRATOR_PASSWORD=
POSTGRES_BACKUP_PASSWORD=
MIGRATE_CONFIRM_DATABASE=
MIGRATE_BACKUP_DONE=

# --- Payments (live payments stay off until the processor is approved) ---
# bachs-live: the payments plan adds it. Today the config knows only mock and bachs-sandbox, and
# production refuses both, so the API will not start until that plan lands. No default.
PAYMENT_PROVIDER=bachs-live
PAYMENTS_LIVE_ENABLED=false
BACHS_SANDBOX_API_KEY=
BACHS_WEBHOOK_SECRET=
# Optional old Bachs signing secret during webhook-secret rotation.
BACHS_PREVIOUS_WEBHOOK_SECRET=
RECONCILE_INTERVAL_MS=
RECONCILE_MIN_AGE_MS=
REWARD_CASH_BUDGET_MINOR_PER_MONTH=

# --- Mail (no default: the deploy refuses until this is chosen) ---
# zeptomail or ses (mock sends nothing). Production mail is ZeptoMail from usetipme.xyz.
MAIL_DEFAULT_PROVIDER=zeptomail
MAIL_FROM_DOMAIN=usetipme.xyz
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME=TipMe
MAIL_REPLY_TO=support@usetipme.xyz
ZEPTOMAIL_API_KEY=
ZEPTOMAIL_API_BASE=
ZEPTOMAIL_WEBHOOK_KEY=
ZEPTOMAIL_BOUNCE_ADDRESS=
# Amazon SES (production access is not granted yet: the account is in the sandbox).
SES_REGION=
SES_ACCESS_KEY_ID=
SES_SECRET_ACCESS_KEY=
SES_CONFIGURATION_SET=
SES_CONFIGURATION_SET_UNTRACKED=
SES_SNS_TOPIC_ARN=

# --- Secrets (fill in; WEB_REVALIDATE_SECRET is the same on Vercel) ---
STATUS_TOKEN_SECRET=
AUTH_CODE_SECRET=
WEB_REVALIDATE_SECRET=
OPS_TOTP_KEY=
MAIL_SEAL_KEY=

# --- Page photos in a private Cloudflare R2 bucket (all four, or none) ---
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# --- Observability and limits (optional; blank takes the default) ---
SENTRY_DSN=
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_TRACES_SAMPLER_RATIO=
OPS_TRACE_URL_TEMPLATE=
API_METRICS_PORT=
WORKER_METRICS_PORT=
LOG_LEVEL=
DIAGNOSTICS_ENABLED=
ANALYTICS_ENABLED=
PORT=
SHUTDOWN_DRAIN_MS=
QUEUE_PREFIX=
RATE_LIMIT_QUOTES_PER_MIN=
RATE_LIMIT_INTENTS_PER_MIN=
RATE_LIMIT_HANDLES_PER_MIN=
RATE_LIMIT_ANALYTICS_PER_MIN=
RATE_LIMIT_REPORTS_PER_HOUR=
RATE_LIMIT_UNSUBSCRIBE_PER_MIN=
RATE_LIMIT_AVATARS_PER_HOUR=
RATE_LIMIT_AUTH_PER_HOUR=
RATE_LIMIT_CODES_PER_NUMBER_PER_HOUR=
