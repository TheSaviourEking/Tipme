# Settings for the edge Caddy (names only). Copy to /srv/tipme-edge/edge.env (chmod 600).
ACME_EMAIL=you@example.com
STAGING_API_HOST=api.staging.example.com
PRODUCTION_API_HOST=api.example.com
# The websites (bare hosts). The apex redirects to https://$PRODUCTION_WEB_HOST.
STAGING_WEB_HOST=staging.example.com
PRODUCTION_WEB_HOST=www.example.com
PRODUCTION_APEX_HOST=example.com
